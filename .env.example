# Site-wide login password (required for /login)
SITE_PASSWORD=

# Optional: secret used to sign the auth cookie (falls back to SITE_PASSWORD).
# Set to a long random string; rotate it to force every device to log in again.
AUTH_SECRET=

# Secret for the Vercel cron endpoint (/api/cron/weekly-schedule).
# Vercel sends it automatically as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# WordPress REST API (defaults to https://memory.emma-kobayashi.com/wp-json/wp/v2)
WORDPRESS_API_URL=

# WordPress Application Password credentials (required for post create/update/delete and media upload)
WORDPRESS_APP_USERNAME=
WORDPRESS_APP_PASSWORD=

# Cloudinary (videos and their thumbnails)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Cloudinary API credentials (required for video upload from the CMS)
# Found in Cloudinary Console > Settings > API Keys
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: folder for uploaded videos (prefixes the public ID)
CLOUDINARY_UPLOAD_FOLDER=
